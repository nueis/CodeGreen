{
  "version": 2,
  "builds": [
    {
      "src": "api/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "api/app.py" }
  ],
  "build": {
    "env": {
      "GH_TOKEN": "@GH_TOKEN"
    },
    "commands": [
      "git submodule update --init --recursive"
    ]
  }
}
